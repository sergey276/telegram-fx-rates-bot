# ============================================================================
#  Скопируйте этот файл в .env и заполните значения:   copy .env.example .env
#  Файл .env содержит секреты — НЕ публикуйте его и не добавляйте в git.
# ============================================================================

# --- Telegram -----------------------------------------------------------------
# Токен бота от @BotFather (инструкция в README, раздел «Создание бота»)
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: бот @userinfobot).
# Только эти пользователи получат доступ к /admin, /stats, /users, /sources, /errors, /addpair.
ADMIN_IDS=

# Язык интерфейса по умолчанию для новых пользователей: ru | uk | en
DEFAULT_LANGUAGE=ru

# Часовой пояс для отображения времени и осей графиков
TIMEZONE=Europe/Kyiv

# --- База данных и кеш --------------------------------------------------------
# docker compose использует эти три значения для контейнера PostgreSQL
# и сам собирает DATABASE_URL — для запуска через Docker менять DATABASE_URL не нужно.
POSTGRES_USER=fxbot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=fxbot

# Для запуска БЕЗ Docker укажите свои адреса (иначе значения берутся из compose):
#   PostgreSQL:  postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
#   SQLite (только для разработки/проверки, без PostgreSQL):  sqlite+aiosqlite:///fxbot.db
# DATABASE_URL=postgresql+asyncpg://fxbot:change-me-to-a-long-random-password@localhost:5432/fxbot
# Redis (необязательно: без него кеш хранится в памяти процесса):
# REDIS_URL=redis://localhost:6379/0

# --- Логирование --------------------------------------------------------------
LOG_LEVEL=INFO

# --- Источники данных ---------------------------------------------------------
# Какие источники включены (через запятую). Остальные настройки ниже — по желанию.
# ENABLED_SOURCES=monobank,privatbank,binance,bybit,okx,bitget,bingx,kucoin

# Пары, добавляемые в каталог при первом запуске (дальше администратор управляет ими командой /addpair)
# DEFAULT_CRYPTO_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT,DOGE/USDT,TON/USDT,ADA/USDT,TRX/USDT,LTC/USDT,AVAX/USDT,LINK/USDT
# DEFAULT_FIAT_PAIRS=USD/UAH,EUR/UAH,EUR/USD,GBP/UAH,PLN/UAH,CHF/UAH,CZK/UAH

# Если биржа недоступна из вашей страны (HTTP 403/451), можно указать зеркало публичного API:
# BINANCE_REST_URL=https://data-api.binance.vision
# BINANCE_WS_URL=wss://data-stream.binance.vision

# Опрос банков (Monobank обновляется не чаще раза в 5 минут — меньше 300 с задать нельзя)
# MONOBANK_POLL_SECONDS=300
# PRIVATBANK_POLL_SECONDS=300
# PRIVATBANK_COURSID=5          # 5 — наличный курс, 11 — безналичный

# Через сколько секунд котировка биржи/банка считается устаревшей (и показывается предупреждение)
# CRYPTO_FRESH_SECONDS=45
# BANK_FRESH_SECONDS=900

# --- Арбитраж -----------------------------------------------------------------
# Комиссии — ОЦЕНКИ (публичный API не отдаёт ваши реальные комиссии). Укажите свои тарифы:
# EXCHANGE_FEES_JSON={"binance": 0.075, "bybit": 0.1, "okx": 0.1, "bitget": 0.1, "bingx": 0.1, "kucoin": 0.1}
# Комиссия за вывод в единицах монеты (зависит от сети):
# WITHDRAW_FEES_JSON={"BTC": 0.0002, "ETH": 0.002, "USDT": 1}
# ARBITRAGE_TRADE_SIZE_USDT=1000
# ARBITRAGE_SLIPPAGE_PCT=0.05

# --- Ограничения --------------------------------------------------------------
# Не более N запросов от одного пользователя за окно (секунды)
# USER_RATE_LIMIT_COUNT=8
# USER_RATE_LIMIT_WINDOW_SECONDS=10
# MAX_ALERTS_PER_USER=20
